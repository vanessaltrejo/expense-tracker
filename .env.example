# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Session cookie encryption. Create it with: npx auth secret
AUTH_SECRET=

# Google service account (the "robot" that reads and writes the Sheets).
# Paste them from its JSON key file. The private key is secret: only in .env.local and Vercel.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Each person's Google Sheet ID (the long code in its URL). Mami reads Vanessa's.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_ID_FRANCISCO=

# Password hashes, never the passwords. Create each one with: npm run hash-password
PASSWORD_HASH_VANESSA=
PASSWORD_HASH_MAMI=
PASSWORD_HASH_FRANCISCO=
